---
/**
 * DayCard — compatibility shim (PR #2a).
 *
 * After PR #2a the landing page renders `DaySection` directly, so
 * `DayCard` becomes a thin summary wrapper around `Card` + `DaySection`
 * for any future "card variant" use. The legacy 3-event preview,
 * `remainingCount`, and `day-card-more` link are retired.
 *
 * The hook contract (`badge--{type}`, `data-event-type`,
 * `id="day-{date}"`, `data-day-id`) is owned by `DaySection` /
 * `EventList` / `Badge`; this shim just composes them inside a
 * token-driven card surface.
 */
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import DaySection from './DaySection.astro';
import type { Locale } from '../lib/event-type-labels';

interface Props {
  day: CollectionEntry<'days-ca' | 'days-es'>;
  lang: Locale;
}

const { day, lang } = Astro.props;
---

<Card as="article" padding="md">
  <DaySection day={day} lang={lang} />
</Card>