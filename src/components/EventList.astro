---
import EventItem from './EventItem.astro';
import type { Locale } from '../lib/event-type-labels';

// Inferred event type from the days-* collections.
type DayEvent = NonNullable<
  import('astro:content').CollectionEntry<'days-ca'>['data']['events']
>[number];

interface Props {
  events: DayEvent[];
  lang: Locale;
  isToday?: boolean;
}

const { events, lang, isToday = false } = Astro.props;
---

<ol data-event-list>
  {
    events.map((event) => (
      <li data-event-type={event.type}>
        <EventItem event={event} lang={lang} isTodayEvent={isToday} />
      </li>
    ))
  }
</ol>

<style>
  ol {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }
</style>
