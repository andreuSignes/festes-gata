---
/**
 * Badge — event-type tone chip with emoji indicator.
 *
 * Each tone maps to a background + text-on-tone pair declared in the
 * @theme event-type tokens (see design.md §2.2). The class
 * `badge--{tone}` matches the legacy convention so existing
 * EventItem consumers continue to work during the dual-CSS window;
 * the new component-scoped rules own the visual tokens and the
 * legacy global selectors retire in PR #2b.
 *
 * The badge is informational only — no interactive semantics — so it
 * is rendered as a non-focusable <span>. Emoji replaces the prior
 * text label; `getEventTypeLabel` remains in the lib for FilterBar.
 */
import type { EventType } from '../lib/event-type-labels';

const EMOJI: Record<EventType, string> = {
  pasacalles: '🎺',
  bous: '🐂',
  verbena: '🎡',
  musica: '🎵',
  liturgia: '⛪',
  infantil: '👶',
  comida: '🍽️',
  festes: '🎊',
  pirotecnia: '🎆',
  otro: '★',
};

interface Props {
  tone: EventType;
  class?: string;
}

const { tone, class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}>{EMOJI[tone]}</span>

<style>
  .badge {
    display: inline-block;
    padding: var(--spacing-1) var(--spacing-2);
    border-radius: var(--radius-full);
    font-size: 1rem;
    line-height: 1.2;
  }

  .badge--pasacalles {
    background: var(--color-pasacalles);
    color: var(--color-pasacalles-fg);
  }
  .badge--bous {
    background: var(--color-bous);
    color: var(--color-bous-fg);
  }
  .badge--verbena {
    background: var(--color-verbena);
    color: var(--color-verbena-fg);
  }
  .badge--musica {
    background: var(--color-musica);
    color: var(--color-musica-fg);
  }
  .badge--liturgia {
    background: var(--color-liturgia);
    color: var(--color-liturgia-fg);
  }
  .badge--infantil {
    background: var(--color-infantil);
    color: var(--color-infantil-fg);
  }
  .badge--comida {
    background: var(--color-comida);
    color: var(--color-comida-fg);
  }
  .badge--festes {
    background: var(--color-festes);
    color: var(--color-festes-fg);
  }
  .badge--otro {
    background: var(--color-otro);
    color: var(--color-otro-fg);
  }
</style>
