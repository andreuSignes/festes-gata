---
/**
 * Badge — event-type tone chip showing emoji only.
 *
 * Each tone maps to a background + text-on-tone pair declared in the
 * @theme event-type tokens. The class `badge--{tone}` drives the
 * background colour; the emoji comes from the shared `eventTypeEmoji`
 * map in event-type-labels.ts.
 *
 * The badge is informational only — no interactive semantics — so it
 * is rendered as a non-focusable <span>.
 */
import { eventTypeEmoji, type EventType } from '../lib/event-type-labels';

interface Props {
  tone: EventType;
  class?: string;
}

const { tone, class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}>{eventTypeEmoji[tone]}</span>

<style>
  .badge {
    display: inline-block;
    padding: var(--spacing-1) var(--spacing-2);
    border-radius: var(--radius-full);
    font-size: 1rem;
    line-height: 1.2;
    font-family: emoji;
  }

  .badge--pasacalles {
    background: var(--color-pasacalles);
    color: var(--color-pasacalles-fg);
  }
  .badge--bous {
    background: var(--color-bous);
    color: var(--color-bous-fg);
  }
  .badge--verbena {
    background: var(--color-verbena);
    color: var(--color-verbena-fg);
  }
  .badge--musica {
    background: var(--color-musica);
    color: var(--color-musica-fg);
  }
  .badge--liturgia {
    background: var(--color-liturgia);
    color: var(--color-liturgia-fg);
  }
  .badge--infantil {
    background: var(--color-infantil);
    color: var(--color-infantil-fg);
  }
  .badge--comida {
    background: var(--color-comida);
    color: var(--color-comida-fg);
  }
  .badge--festes {
    background: var(--color-festes);
    color: var(--color-festes-fg);
  }
  .badge--pirotecnia {
    background: var(--color-pirotecnia);
    color: var(--color-pirotecnia-fg);
  }
</style>
