---
/**
 * FilterBar — locale-aware event-type filter ("tag cloud").
 *
 * Renders 9 type chips (one per `EventType`) plus two bulk controls:
 *
 *  - Reset (`data-filter-reset`) refills the active set so every type
 *    is selected again. Its single locale-aware label combines the
 *    "all" and "reset" copy into one string (e.g. `Tots / Reiniciar`)
 *    so the verification gate can find both control strings in the
 *    active locale (`Tots` + `Reiniciar` in CA, `Todos` + `Reiniciar`
 *    in ES).
 *  - Clear-all (`data-filter-clear`) empties the active set: every
 *    chip flips to `aria-pressed="false"` and all events hide. This
 *    lets a visitor isolate a single type with one extra tap, or
 *    exclude one type via reset + deselect.
 *
 * Mobile UX (≤639px): the bar shows a single "Filtrar" trigger button
 * that opens a bottom sheet containing the full chip set. This
 * eliminates the ~200px vertical consumption of the wrapped pill cloud
 * on small screens while keeping all filter functionality accessible.
 *
 * The active locale drives every visible label (chip text, group
 * label, control labels) via the shared `getEventTypeLabel(type,
 * lang)` helper and a small constants map.
 *
 * Visual design: a sticky pill cloud on desktop; a bottom-sheet
 * pattern on mobile. Each chip is a fully rounded pill with a
 * colored dot and a per-type accent drawn from the global
 * `--color-{type}` / `--color-{type}-fg` tokens (exposed here as the
 * component-scoped `--chip-accent` / `--chip-on-accent` properties).
 * Pressed chips get a soft tint of their accent (via `color-mix`,
 * with the solid accent as fallback), unpressed chips are muted
 * ghost/outline pills. The bar itself is `position: sticky` under the
 * page top with a translucent blurred backdrop so it stays usable
 * across the long 12-day landing. The two bulk controls sit in an
 * end-aligned subgroup with smaller secondary styling, visually
 * separate from the type chips.
 *
 * The bar is non-functional on its own — the bounded script in
 * `src/scripts/festival-interactivity.ts` walks the data hooks and
 * toggles `aria-pressed`, `hidden`, and `tabindex` on the matching
 * event `<li>` nodes. The no-script document remains complete and
 * usable: every chip is `aria-pressed="true"` initially so all events
 * are visible without JS.
 */
import {
  eventTypeLabels,
  eventTypeEmoji,
  getEventTypeLabel,
  type EventType,
  type Locale,
} from '../lib/event-type-labels';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// The 9 EventType keys, in the canonical order pinned by the
// `eventTypeLabels` Record. Astro components cannot iterate a Record
// in a stable order across runtimes, so we use `Object.keys` which V8
// preserves in insertion order for non-integer string keys.
const types = Object.keys(eventTypeLabels) as EventType[];

// Localised control copy. The reset button combines the "all" and
// "reset" copy so both required strings appear in the active locale.
const controlCopy: Record<Locale, { all: string; reset: string; none: string }> = {
  ca: { all: 'Tots', reset: 'Reiniciar', none: 'Cap' },
  es: { all: 'Todos', reset: 'Reiniciar', none: 'Ninguno' },
};

const groupLabel = lang === 'ca' ? 'Filtrar per tipus' : 'Filtrar por tipo';
const filterLabel = lang === 'ca' ? 'Filtrar' : 'Filtrar';
const resetLabel = `${controlCopy[lang].all} / ${controlCopy[lang].reset}`;
const clearLabel = controlCopy[lang].none;
const closeLabel = lang === 'ca' ? 'Tancar' : 'Cerrar';
const filterCountInitial = lang === 'ca' ? '9/9 actius' : '9/9 activos';
---

<!-- Mobile trigger: only visible on ≤639px -->
<button
  type="button"
  class="filter-trigger"
  data-filter-trigger
  aria-label={filterLabel}
  aria-expanded="false"
  aria-controls="filter-sheet"
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <line x1="4" y1="6" x2="20" y2="6"></line>
    <line x1="8" y1="12" x2="16" y2="12"></line>
    <line x1="11" y1="18" x2="13" y2="18"></line>
  </svg>
  {filterLabel}
</button>

<!-- Bottom sheet: chips + controls -->
<div
  id="filter-sheet"
  class="filter-sheet"
  data-filter-sheet
  role="dialog"
  aria-modal="true"
  aria-label={groupLabel}
>
  <div class="filter-sheet__header">
    <span class="filter-sheet__title">{groupLabel}</span>
    <span class="filter-count-badge" aria-live="polite" data-filter-count>{filterCountInitial}</span
    >
    <button
      type="button"
      class="filter-sheet__close"
      data-filter-sheet-close
      aria-label={closeLabel}
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <div class="filter-sheet__chips">
    {
      types.map((type) => (
        <button
          type="button"
          class="filter-btn"
          data-filter-type={type}
          aria-pressed="true"
          lang={lang}
        >
          <span class="filter-dot" aria-hidden="true" />
          <span class="filter-emoji">{eventTypeEmoji[type]}</span>
          {getEventTypeLabel(type, lang)}
        </button>
      ))
    }
  </div>
  <div class="filter-sheet__controls">
    <button
      type="button"
      class="filter-btn filter-btn--control"
      data-filter-reset
      aria-pressed="false"
      lang={lang}
    >
      {resetLabel}
    </button>
    <button
      type="button"
      class="filter-btn filter-btn--control"
      data-filter-clear
      aria-pressed="false"
      lang={lang}
    >
      {clearLabel}
    </button>
  </div>
</div>

<!-- Backdrop -->
<div class="filter-backdrop" data-filter-backdrop aria-hidden="true"></div>

<style>
  /* === Bar layout: sticky pill cloud (desktop) === */
  [data-filter-bar] {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
    padding-block: var(--spacing-3);
    margin-bottom: var(--spacing-4);
    background: var(--color-surface);
  }

  @supports (backdrop-filter: blur(1px)) {
    [data-filter-bar] {
      background: color-mix(in srgb, var(--color-surface) 85%, transparent);
      backdrop-filter: blur(10px);
    }
  }

  .filter-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .filter-count-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-surface-elevated);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .filter-count-badge.bounce {
      animation: count-bounce 300ms ease-out;
    }
  }

  @keyframes count-bounce {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
    }
  }

  /* === Per-type accent tokens (aliases of the global palette) === */
  .filter-btn[data-filter-type='pasacalles'] {
    --chip-accent: var(--color-pasacalles);
    --chip-on-accent: var(--color-pasacalles-fg);
  }
  .filter-btn[data-filter-type='bous'] {
    --chip-accent: var(--color-bous);
    --chip-on-accent: var(--color-bous-fg);
  }
  .filter-btn[data-filter-type='verbena'] {
    --chip-accent: var(--color-verbena);
    --chip-on-accent: var(--color-verbena-fg);
  }
  .filter-btn[data-filter-type='musica'] {
    --chip-accent: var(--color-musica);
    --chip-on-accent: var(--color-musica-fg);
  }
  .filter-btn[data-filter-type='liturgia'] {
    --chip-accent: var(--color-liturgia);
    --chip-on-accent: var(--color-liturgia-fg);
  }
  .filter-btn[data-filter-type='infantil'] {
    --chip-accent: var(--color-infantil);
    --chip-on-accent: var(--color-infantil-fg);
  }
  .filter-btn[data-filter-type='comida'] {
    --chip-accent: var(--color-comida);
    --chip-on-accent: var(--color-comida-fg);
  }
  .filter-btn[data-filter-type='festes'] {
    --chip-accent: var(--color-festes);
    --chip-on-accent: var(--color-festes-fg);
  }
  .filter-btn[data-filter-type='pirotecnia'] {
    --chip-accent: var(--color-pirotecnia);
    --chip-on-accent: var(--color-pirotecnia-fg);
  }

  /* === Chip base: pill with dot, comfortable touch target === */
  .filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    min-height: 44px;
    padding-inline: var(--spacing-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface-elevated);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  .filter-dot {
    inline-size: 0.625rem;
    block-size: 0.625rem;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--chip-accent, var(--color-text-muted));
  }

  /* Ensure emoji renders with native font (not affected by text color) */
  .filter-emoji {
    font-family: emoji;
    line-height: 1;
  }

  /* Unpressed: muted ghost/outline, still obviously clickable. */
  .filter-btn[aria-pressed='false'] {
    background: var(--color-surface-elevated);
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .filter-btn[aria-pressed='false']:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  /* Pressed: soft tint of the type accent + colored border + dark
     on-tint text. The solid accent is the no-`color-mix` fallback —
     it pairs with `--chip-on-accent` exactly like Badge does. */
  .filter-btn[aria-pressed='true'] {
    border-color: var(--chip-accent);
    background: var(--chip-accent);
    background: color-mix(in srgb, var(--chip-accent) 24%, var(--color-surface-elevated));
    color: var(--chip-on-accent);
  }

  /* === Bulk controls: end-aligned subgroup, secondary styling === */
  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-inline-start: auto;
  }

  .filter-btn--control {
    min-height: 40px;
    padding-inline: var(--spacing-3);
    font-size: 0.875rem;
    background: transparent;
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .filter-btn--control:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  /* === Motion: subtle raise on hover, 160ms transitions, gated on
     no-preference so reduced-motion users get instant state changes. === */
  @media (prefers-reduced-motion: no-preference) {
    .filter-btn {
      transition:
        background-color 160ms ease,
        border-color 160ms ease,
        color 160ms ease,
        box-shadow 160ms ease,
        transform 160ms ease;
    }

    .filter-btn:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }
  }

  /* === Mobile: hide desktop chips, show trigger === */
  @media (min-width: 640px) {
    [data-filter-trigger] {
      display: none;
    }
  }

  /* === Mobile trigger button === */
  [data-filter-trigger] {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: 44px;
    padding-inline: var(--spacing-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface-elevated);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  /* === Bottom sheet === */
  .filter-sheet {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--color-surface-elevated);
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    padding: var(--spacing-4);
    padding-bottom: calc(var(--spacing-4) + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -4px 24px rgba(26, 22, 18, 0.12);
  }

  .filter-sheet[data-open] {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .filter-sheet {
      transform: translateY(100%);
      transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .filter-sheet[data-open] {
      transform: translateY(0);
    }

    .filter-backdrop {
      transition: opacity 300ms ease;
    }
  }

  @media (min-width: 640px) {
    .filter-sheet,
    .filter-backdrop {
      display: none !important;
    }
  }

  .filter-sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-4);
  }

  .filter-sheet__title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
  }

  .filter-sheet__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-surface-muted);
    color: var(--color-text);
    cursor: pointer;
  }

  .filter-sheet__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-4);
  }

  .filter-sheet__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    padding-top: var(--spacing-3);
    border-top: 1px solid var(--color-border);
  }

  /* === Backdrop === */
  .filter-backdrop {
    position: fixed;
    inset: 0;
    z-index: 199;
    background: rgba(26, 22, 18, 0.4);
    opacity: 0;
    pointer-events: none;
  }

  .filter-backdrop[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
</style>
