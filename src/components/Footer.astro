---
/**
 * Footer — token-driven site chrome.
 *
 * Maps the legacy `site-footer` class onto the muted surface +
 * muted text tokens so the Footer reads as a low-emphasis surface
 * distinct from the primary-coloured Header. Copy is preserved
 * verbatim (Comissió 2026 · Gata de Gorgos · © {year}).
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p>Comissió 2026 · Gata de Gorgos · &copy; {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-block: var(--spacing-5);
    margin-top: var(--spacing-8);
  }

  .site-footer-inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding-inline-mobile);
  }
  @media (min-width: 640px) {
    .site-footer-inner {
      padding-inline: var(--container-padding-inline-desktop);
    }
  }

  .site-footer p {
    text-align: center;
    font-size: 0.875rem;
  }
</style>
