---
/**
 * Card — semantic content container.
 *
 * Renders a static, framework-free article/section/aside/div (or an
 * anchor when `href` is supplied) that consumes the design-system
 * surface/elevation tokens defined in `src/styles/global.css`.
 *
 * Background uses --color-surface-elevated with --shadow-card so the
 * card reads as a "resting" elevated surface. When linked, the entire
 * card becomes a native `<a>` with a 44px minimum target and the
 * shared :focus-visible ring.
 */
interface Props {
  as?: 'article' | 'section' | 'aside' | 'div';
  padding?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
}

const { as = 'article', padding = 'md', href, class: className } = Astro.props;
const Tag = as;
const baseClass = ['card', `card--pad-${padding}`, className];
const linkedClass = ['card', 'card--linked', className];
---

{
  href ? (
    <a class:list={linkedClass} href={href}>
      <slot />
    </a>
  ) : (
    <Tag class:list={baseClass}>
      <slot />
    </Tag>
  )
}

<style>
  .card {
    display: block;
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-card);
    color: var(--color-text);
    text-decoration: none;
  }

  .card--linked {
    min-height: 44px;
  }

  .card--pad-sm {
    padding: var(--spacing-3);
  }

  .card--pad-md {
    padding: var(--spacing-5);
  }

  .card--pad-lg {
    padding: var(--spacing-6);
  }
</style>
