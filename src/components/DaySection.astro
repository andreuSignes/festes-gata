---
import type { CollectionEntry } from 'astro:content';
import EventList from './EventList.astro';
import type { Locale } from '../lib/event-type-labels';
import { parseLocale, DEFAULT_LOCALE } from '../lib/locale';

interface Props {
  day: CollectionEntry<'days-ca' | 'days-es'>;
  lang?: Locale;
  /**
   * Heading level for the day title inside this section.
   *
   * Landing: defaults to `<h2>` (under the page-level `<h1>`).
   * Detail: pass `1` so this section becomes the page's single `<h1>`
   * (the date detail page has no other heading).
   */
  headingLevel?: 1 | 2;
  /**
   * Whether this day is today's date (Europe/Madrid).
   * Landing page computes this at build time and passes it.
   * When true, the section gets a today-highlight border + glow.
   */
  isToday?: boolean;
}

const { day, lang: langProp, headingLevel = 2, isToday = false } = Astro.props;

// Explicit prop wins for reuse; otherwise (defensively) parse the
// route param. `parseLocale` rejects unknown values instead of
// letting TypeScript silently cast an off-spec locale to `Locale`.
const lang: Locale = langProp ?? parseLocale(Astro.params.lang) ?? DEFAULT_LOCALE;

const id = `day-${day.id}`;
const titleId = `${id}-title`;
const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';

// Locale-specific empty-day copy (script in PR #3 toggles `hidden`).
const emptyDayCopy: Record<Locale, string> = {
  ca: 'No hi ha actes',
  es: 'No hay actos',
};
---

<section
  id={id}
  data-day-id={day.id}
  data-day-is-today={isToday ? 'true' : undefined}
  aria-labelledby={titleId}
>
  <header data-day-header>
    <time datetime={day.data.date}>{day.data.date}</time>
    <HeadingTag id={titleId} transition:name={`day-title-${day.id}`}>
      {day.data.weekday}
      {day.data.theme ? `: ${day.data.theme}` : ''}
    </HeadingTag>
  </header>
  <EventList events={day.data.events} lang={lang} isToday={isToday} />
  <!--
    Empty-day live region. PR #3's bounded script (`initFilters`) flips
    the `hidden` attribute based on the active filter state for the
    day. Copy is the locale-specific message; default `hidden` until
    the script determines the day has no matching events.
  -->
  <p class="visually-hidden" role="status" aria-live="polite" data-empty-day hidden>
    {emptyDayCopy[lang]}
  </p>
</section>

<style>
  section {
    margin-bottom: var(--spacing-6);
  }

  header {
    margin-bottom: var(--spacing-5);
  }

  /* === Today highlight: top-border accent + subtle glow === */
  @media (prefers-reduced-motion: no-preference) {
    section[data-day-is-today='true'] {
      border-top: 3px solid var(--color-accent);
      padding-top: var(--spacing-3);
      animation: today-glow 2s ease-out both;
    }

    @keyframes today-glow {
      0% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 60%, transparent);
      }
      50% {
        box-shadow: 0 0 12px 2px color-mix(in srgb, var(--color-accent) 40%, transparent);
      }
      100% {
        box-shadow: 0 0 4px 0 color-mix(in srgb, var(--color-accent) 20%, transparent);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    section[data-day-is-today='true'] {
      border-top: 3px solid var(--color-accent);
      padding-top: var(--spacing-3);
    }
  }

  /* === Scroll-driven reveal: fade + slide up when entering viewport === */
  @media (prefers-reduced-motion: no-preference) {
    /* CSS Scroll-driven Animations (Chrome/Edge/Firefox).
       The @keyframes animation runs via animation-timeline: view(). */
    section {
      animation: day-reveal 0.5s ease-out both;
      animation-timeline: view();
      animation-range: entry 0% entry 100%;
    }

    @keyframes day-reveal {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* IntersectionObserver fallback (Safari + browsers without view()):
       data-day-revealed is set by initScrollReveal() in festival-interactivity.ts */
    section[data-day-revealed='true'] {
      animation: day-reveal 0.5s ease-out both;
    }

    @keyframes day-reveal {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
