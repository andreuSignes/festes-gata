---
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: 'ca' | 'es';
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = `${base}/${lang}/`;
const pathname = Astro.url.pathname;

const labels = {
  ca: { nav: 'Hui', brand: 'Festes de Gata', navAria: 'Anar al dia d’hui' },
  es: { nav: 'Hoy', brand: 'Festes de Gata', navAria: 'Ir al día de hoy' },
};

const navLinks = [{ href: homeHref, label: labels[lang].nav, ariaLabel: labels[lang].navAria }];

// Get the path without the locale prefix (or BASE_URL + locale prefix) for the
// language switcher. `Astro.url.pathname` includes the `base` (e.g.
// `/festes-gata/ca/`) at build time, so the regex must match both the bare
// `/ca/` form and the `${base}/ca/` form.
const pathWithoutLocale =
  pathname.replace(new RegExp(`^${base.replace(/\/$/, '')}/?(ca|es)`), '') || '/';
---

<header class="site-header">
  <div class="header-inner">
    <a href={homeHref} class="brand" hreflang={lang} lang={lang} transition:name="brand">
      <span class="brand-name">{labels[lang].brand}</span>
      <span class="brand-year">2026</span>
    </a>
    <nav aria-label="Principal">
      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { 'is-active': pathname.startsWith(link.href) }]}
                aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
                aria-label={link.ariaLabel}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguageSwitcher currentLocale={lang} currentPath={pathWithoutLocale} />
  </div>
</header>

<style>
  .site-header {
    background: var(--color-primary);
    color: var(--color-surface-elevated);
    border-bottom: 4px solid var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      animation: header-shift 12s ease infinite;
    }

    @keyframes header-shift {
      0% {
        background: #d5438c;
      }
      33% {
        background: #c43a7d;
      }
      66% {
        background: #e54a96;
      }
      100% {
        background: #d5438c;
      }
    }
  }

  .header-inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--spacing-4) var(--container-padding-inline-mobile);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-3);
  }

  .brand {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-2);
    min-height: 44px;
  }

  .brand {
    flex: 1 0 100%;
  }

  .brand-name {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .brand-year {
    background: var(--color-accent);
    color: var(--color-primary);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .nav-link {
    color: inherit;
    text-decoration: none;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width 200ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      width: 100%;
    }
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: var(--color-secondary);
  }

  .nav-link.is-active {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .header-inner {
      padding: var(--spacing-5) var(--container-padding-inline-desktop);
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      flex: 0 1 auto;
    }
  }
</style>
