---
/**
 * Header — token-driven site chrome.
 *
 * The class names match the legacy DOM (`site-header`, `header-inner`,
 * `brand`, `nav-list`, `nav-link`, `is-active`) so PR #2 can swap any
 * selector onto Card/Button primitives without touching the markup.
 * The Programa nav link points at the landing route (`/`); there is
 * no `/programa/` index in v1 (only per-day deep links).
 */
const base = import.meta.env.BASE_URL;
const homeHref = `${base}/`;
const pathname = Astro.url.pathname;
const navLinks = [{ href: homeHref, label: 'Programa' }];
---

<header class="site-header">
  <div class="header-inner">
    <a href={homeHref} class="brand">
      <span class="brand-name">Festes de Gata</span>
      <span class="brand-year">2026</span>
    </a>
    <nav aria-label="Principal">
      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { 'is-active': pathname.startsWith(link.href) }]}
                aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-primary);
    color: var(--color-surface-elevated);
    border-bottom: 4px solid var(--color-accent);
  }

  .header-inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .brand {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-2);
    min-height: 44px;
  }

  .brand-name {
    font-size: var(--font-size-lg, 1.375rem);
    font-weight: 700;
  }

  .brand-year {
    background: var(--color-accent);
    color: var(--color-primary);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 700;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .nav-link {
    color: inherit;
    text-decoration: none;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: var(--color-secondary);
  }

  .nav-link.is-active {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .header-inner {
      padding: var(--spacing-5);
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
