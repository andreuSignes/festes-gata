---
import { LOCALES, type Locale, localizedPath } from '../lib/locale';

interface Props {
  currentLocale: Locale;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;
const base = import.meta.env.BASE_URL;

const labels: Record<Locale, string> = {
  ca: 'VAL',
  es: 'ESP',
};

const selectLabel: Record<Locale, string> = {
  ca: 'Llengua',
  es: 'Idioma',
};
---

<div class="lang-switcher">
  <select class="lang-select" aria-label={selectLabel[currentLocale]} data-lang-select>
    {
      LOCALES.map((locale) => (
        <option
          value={localizedPath(locale, base, currentPath)}
          selected={currentLocale === locale}
          lang={locale}
          data-locale={locale}
        >
          {labels[locale]}
        </option>
      ))
    }
  </select>
  <!-- The select needs JS to navigate; keep plain links as a no-JS fallback. -->
  <noscript>
    <ul class="lang-list">
      {
        LOCALES.map((locale) => (
          <li>
            <a
              href={localizedPath(locale, base, currentPath)}
              class:list={['lang-link', { 'is-active': currentLocale === locale }]}
              hreflang={locale}
              lang={locale}
            >
              {labels[locale]}
            </a>
          </li>
        ))
      }
    </ul>
  </noscript>
</div>

<script is:inline>
  // Locale storage key is replicated as a literal here because this
  // is an inlined script that cannot import from `src/lib/locale.ts`.
  // KEEP IN SYNC with `LOCALE_STORAGE_KEY` in `src/lib/locale.ts`.
  var FESTES_GATA_LOCALE_KEY = 'festes-gata:locale:v1';
  document.querySelectorAll('[data-lang-select]').forEach(function (select) {
    select.addEventListener('change', function (event) {
      var target = event.target;
      if (target instanceof HTMLSelectElement && target.value) {
        var opt = target.options[target.selectedIndex];
        if (opt && opt.dataset.locale) {
          try {
            localStorage.setItem(FESTES_GATA_LOCALE_KEY, opt.dataset.locale);
          } catch (e) {
            void e;
          }
        }
        window.location.href = target.value;
      }
    });
  });
</script>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
  }

  .lang-select {
    padding: var(--spacing-2) var(--spacing-3);
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-secondary);
    color: inherit;
    font: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    min-height: 44px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lang-select:hover,
  .lang-select:focus-visible {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--spacing-2);
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    min-height: 44px;
    transition: background-color 0.2s ease;
  }

  .lang-link:hover,
  .lang-link:focus-visible {
    background: var(--color-secondary);
  }

  .lang-link.is-active {
    background: var(--color-accent);
    color: var(--color-primary);
  }
</style>
