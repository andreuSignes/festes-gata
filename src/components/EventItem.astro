---
import Badge from './Badge.astro';
import type { EventType, Locale } from '../lib/event-type-labels';

interface Props {
  event: {
    time: string;
    title: string;
    type: EventType;
    location?: string | undefined;
    description?: string | undefined;
    sponsor?: string | undefined;
    tags?: string[] | undefined;
  };
  lang?: Locale;
  isTodayEvent?: boolean;
}

const { event, lang = 'es', isTodayEvent = false } = Astro.props;

const locationLabels: Record<Locale, string> = {
  ca: 'Lloc:',
  es: 'Lugar:',
};
---

<article class="event-item">
  <div class="event-meta">
    <time datetime={event.time} class="event-time">
      {event.time}
      {isTodayEvent && <span class="live-dot" aria-hidden="true" />}
    </time>
    <Badge tone={event.type} />
  </div>
  <h3 class="event-title">{event.title}</h3>
  {
    event.location && (
      <p class="event-location">
        <span class="visually-hidden">{locationLabels[lang]} </span>
        {event.location}
      </p>
    )
  }
  {event.description && <p class="event-description">{event.description}</p>}
  {
    event.sponsor && (
      <p class="event-sponsor">
        <small>
          {lang === 'ca' ? 'Patrocinat per' : 'Patrocinado por'} <strong>{event.sponsor}</strong>
        </small>
      </p>
    )
  }
</article>

<style>
  .event-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    flex-wrap: wrap;
  }

  .event-time {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .live-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-dot {
      animation: live-pulse 1.4s ease-in-out infinite;
    }
  }

  @keyframes live-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.85);
    }
  }

  .event-title {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .event-location {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .event-description {
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .event-sponsor {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
