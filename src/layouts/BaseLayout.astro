---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang: 'ca' | 'es';
  ogImage?: string;
}

const {
  title,
  description,
  lang,
  ogImage = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/default.svg`,
} = Astro.props;

const siteName = 'Festes de Gata 2026';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImgUrl = new URL(ogImage, Astro.site).toString();

// Mount the bounded interactivity script only on the locale landing
// routes (`/${lang}/`). Per-day detail pages and the universal 404
// stay script-free. Astro bundles the script once and emits a single
// <script src="...">` tag on each landing HTML.
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const landingPath = `${baseUrl}/${lang}/`;
const isLanding = Astro.url.pathname === landingPath;

const localeMap = {
  ca: 'ca_ES',
  es: 'es_ES',
};
---

<!doctype html>
<!--
  theme-color mirrors the festive primary from the cover image
  (docs/FESTES_GATA_2026_PORTADA-727x1024.jpg). Kept as a literal hex
  because <meta name="theme-color"> does not resolve CSS custom
  properties. The authoritative token is --color-primary in
  src/styles/global.css.
-->
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e5318a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImgUrl} />
    <meta property="og:locale" content={localeMap[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImgUrl} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {isLanding && <script>import '../scripts/festival-interactivity.ts';</script>}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -40px;
    left: var(--spacing-2);
    background: var(--color-primary);
    color: #fff;
    padding: var(--spacing-3) var(--spacing-4);
    border-radius: var(--radius-md);
    z-index: 100;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .skip-link:focus {
    top: var(--spacing-2);
  }
</style>
