---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildHreflangTags } from '../lib/seo-hreflang';

interface Props {
  title: string;
  description: string;
  lang: 'ca' | 'es';
  ogImage?: string;
  jsonLd?: object[];
}

const {
  title,
  description,
  lang,
  ogImage = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/default.png`,
  jsonLd = [],
} = Astro.props;

const siteName = 'Festes de Gata 2026';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImgUrl = new URL(ogImage, Astro.site).toString();

// Mount the bounded interactivity script only on the locale landing
// routes (`/${lang}/`). Per-day detail pages and the universal 404
// stay script-free. Astro bundles the script once and emits a single
// <script src="...">` tag on each landing HTML.
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const landingPath = `${baseUrl}/${lang}/`;
const isLanding = Astro.url.pathname === landingPath;

const localeMap = {
  ca: 'ca_ES',
  es: 'es_ES',
};
const otherLocaleMap: Record<'ca' | 'es', 'ca_ES' | 'es_ES'> = {
  ca: 'es_ES',
  es: 'ca_ES',
};

const ogImageAlt: Record<'ca' | 'es', string> = {
  ca: 'Programa de les Festes de Gata 2026',
  es: 'Programa de las Fiestas de Gata 2026',
};

const hreflangTags = buildHreflangTags(
  Astro.url.pathname,
  lang,
  Astro.site ?? Astro.url.origin,
  import.meta.env.BASE_URL
);
---

<!doctype html>
<!--
  theme-color mirrors the festive primary from the cover image
  (docs/FESTES_GATA_2026_PORTADA-727x1024.jpg). Kept as a literal hex
  because <meta name="theme-color"> does not resolve CSS custom
  properties. The authoritative token is --color-primary in
  src/styles/global.css.
-->
<html lang={lang} data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e5318a" />
    <script is:inline>
      (function () {
        var b = document.documentElement.dataset.base || '';
        var re = new RegExp('^' + (b ? b + '/' : '/') + '(ca|es)(/|$)');
        var m = location.pathname.match(re);
        if (!m) return;
        var cur = m[1];
        var tail = location.pathname.slice(m.index + m[0].length - (m[2] === '/' ? 1 : 0));
        var stored = null;
        try {
          stored = localStorage.getItem('festes-gata:locale');
        } catch (e) {
          void e;
        }
        if (stored !== 'ca' && stored !== 'es') {
          var ls = navigator.languages || [navigator.language];
          for (var i = 0; i < ls.length && stored === null; i++) {
            var c = String(ls[i]).split('-')[0].toLowerCase();
            if (c === 'ca' || c === 'es') stored = c;
          }
        }
        if (!stored || stored === cur) return;
        var prefix = b ? b + '/' : '/';
        var t = prefix + stored + tail + location.search + location.hash;
        if (t !== location.pathname + location.search + location.hash) location.replace(t);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangTags.map((tag) => <link rel={tag.rel} hreflang={tag.hreflang} href={tag.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImgUrl} />
    <meta property="og:locale" content={localeMap[lang]} />
    <meta property="og:locale:alternate" content={otherLocaleMap[lang]} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImgUrl} />
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "1c2253a7e67b4aaca8ae6f91728e65a2"}'></script>
    <meta name="twitter:image:alt" content={ogImageAlt[lang]} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {isLanding && <script>import '../scripts/festival-interactivity.ts';</script>}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -40px;
    left: var(--spacing-2);
    background: var(--color-primary);
    color: #fff;
    padding: var(--spacing-3) var(--spacing-4);
    border-radius: var(--radius-md);
    z-index: 100;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .skip-link:focus {
    top: var(--spacing-2);
  }
</style>
