---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DayCard from '../components/DayCard.astro';

const days = (await getCollection('days')).sort(
  (a, b) => a.data.date.localeCompare(b.data.date),
);
---

<BaseLayout
  title="Festes de Gata 2026"
  description="Programa oficial de las fiestas en honor al Santísimo Cristo del Calvario de Gata de Gorgos. Del 26 de julio al 6 de agosto de 2026."
>
  <section class="hero">
    <h1>Festes de Gata 2026</h1>
    <p>
      Programa oficial de las fiestas en honor al Santísimo Cristo del Calvario.
      Del 26 de julio al 6 de agosto de 2026.
    </p>
  </section>
  <section>
    <h2 class="visually-hidden">Programa por días</h2>
    <ul class="days-grid">
      {
        days.map((day) => (
          <li>
            <DayCard day={day} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>