---
// Root index — client-side redirect to the appropriate locale
// Default to Catalan (ca) if no match
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting...</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      // Supported locales in priority order
      var supportedLocales = ['ca', 'es'];
      var defaultLocale = 'ca';

      // Parse Accept-Language header simulated via navigator.languages
      var browserLangs = navigator.languages || [navigator.language || defaultLocale];

      var targetLocale = defaultLocale;
      for (var i = 0; i < browserLangs.length; i++) {
        var lang = browserLangs[i].split('-')[0].toLowerCase();
        if (supportedLocales.indexOf(lang) !== -1) {
          targetLocale = lang;
          break;
        }
      }

      // Redirect to the target locale
      var base = '/festes-gata';
      var targetUrl = base + '/' + targetLocale + '/';
      window.location.href = targetUrl;
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/festes-gata/ca/" />
    </noscript>
  </head>
  <body>
    <p>Redirigint... <a href="/festes-gata/ca/">Fes clic ací si no es redirigeix.</a></p>
  </body>
</html>
