---
/**
 * Universal not-found page.
 *
 * Static hosting (GitHub Pages) only serves a single `404.html` per
 * site. The active locale is detected from `Astro.url.pathname` so the
 * message and the back link match whatever route the user was
 * navigating when they hit the missing page.
 *
 * Locale-prefixed `dist/ca/404.html` / `dist/es/404.html` are emitted
 * by the explicit `src/pages/{ca,es}/404.astro` siblings; this file
 * remains the safety-net fallback for any non-localized URL.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../lib/event-type-labels';

const base = import.meta.env.BASE_URL;

const pathname = Astro.url.pathname;
const detected = pathname.match(/^\/(ca|es)(\/|$)/)?.[1];
const lang: Locale = detected === 'es' ? 'es' : 'ca';
const homeHref = `${base}/${lang}/`;

const copy: Record<
  Locale,
  { title: string; description: string; heading: string; body: string; back: string }
> = {
  ca: {
    title: 'Pàgina no trobada',
    description: 'La pàgina que busques no existeix.',
    heading: '404 — Pàgina no trobada',
    body: 'No hem trobat la pàgina que busques.',
    back: 'Tornar a l’inici',
  },
  es: {
    title: 'Página no encontrada',
    description: 'La página que buscas no existe.',
    heading: '404 — Página no encontrada',
    body: 'No hemos encontrado la página que buscas.',
    back: 'Volver al inicio',
  },
};

const t = copy[lang];
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <section>
    <h1>{t.heading}</h1>
    <p>{t.body}</p>
    <p><a href={homeHref}>← {t.back}</a></p>
  </section>
</BaseLayout>
