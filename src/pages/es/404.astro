---
/**
 * ES locale-specific not-found page.
 *
 * Emits `dist/es/404.html` so the per-locale gate assertion is met
 * (`dist/ca/404.html` and `dist/es/404.html` each contain the
 * locale-specific 404 message). The universal `src/pages/404.astro`
 * remains the safety-net fallback for any non-localized URL.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const homeHref = `${base}/es/`;
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe."
  lang="es"
>
  <section>
    <h1>404 — Página no encontrada</h1>
    <p>No hemos encontrado la página que buscas.</p>
    <p><a href={homeHref}>← Volver al inicio</a></p>
  </section>
</BaseLayout>