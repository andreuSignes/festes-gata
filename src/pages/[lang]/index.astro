---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DaySection from '../../components/DaySection.astro';
import FilterBar from '../../components/FilterBar.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'ca' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params as { lang: 'ca' | 'es' };

const collectionName = lang === 'ca' ? 'days-ca' : 'days-es';
const days = (await getCollection(collectionName)).sort((a, b) =>
  a.data.date.localeCompare(b.data.date)
);

const titles: Record<'ca' | 'es', { page: string; description: string }> = {
  ca: {
    page: 'Festes de Gata 2026',
    description:
      'Programa oficial de les festes en honor al Santíssim Crist del Calvari de Gata de Gorgos. Del 26 de juliol al 6 de agost de 2026.',
  },
  es: {
    page: 'Festes de Gata 2026',
    description:
      'Programa oficial de las fiestas en honor al Santísimo Cristo del Calvario de Gata de Gorgos. Del 26 de julio al 6 de agosto de 2026.',
  },
};

const { page: title, description } = titles[lang];
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="hero">
    <h1>{title}</h1>
    <p>{description}</p>
  </section>
  <section>
    <FilterBar lang={lang} />
    <h2 class="visually-hidden">
      {lang === 'ca' ? 'Programa per dies' : 'Programa por días'}
    </h2>
    <ul class="days-grid">
      {
        days.map((day) => (
          <li>
            <DaySection day={day} lang={lang} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding-block: var(--spacing-6);
    border-bottom: 2px solid var(--color-accent);
    margin-bottom: var(--spacing-6);
  }

  .hero h1 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-3);
  }

  .hero p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 38rem;
    margin-inline: auto;
  }

  .days-grid {
    display: grid;
    row-gap: var(--spacing-6);
    column-gap: var(--spacing-4);
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .days-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-5);
    }
  }

  @media (min-width: 1024px) {
    .days-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-5);
    }

    .hero {
      padding-block: var(--spacing-12);
    }

    .hero p {
      font-size: 1.375rem;
    }
  }
</style>
