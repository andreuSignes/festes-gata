---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DaySection from '../../../components/DaySection.astro';
import { buildDayEvent, buildBreadcrumbList } from '../../../lib/json-ld';

type DayCollectionEntry = CollectionEntry<'days-ca' | 'days-es'>;

export async function getStaticPaths() {
  const caDays = await getCollection('days-ca');
  const esDays = await getCollection('days-es');

  const caPaths = caDays.map((day) => ({
    params: { lang: 'ca', date: day.id },
    props: { day, lang: 'ca' as const },
  }));

  const esPaths = esDays.map((day) => ({
    params: { lang: 'es', date: day.id },
    props: { day, lang: 'es' as const },
  }));

  return [...caPaths, ...esPaths];
}

interface Props {
  day: DayCollectionEntry;
  lang: 'ca' | 'es';
}

const { day, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = `${base}/${lang}/`;

const labels: Record<'ca' | 'es', { back: string }> = {
  ca: { back: 'Tornar al programa' },
  es: { back: 'Volver al programa' },
};

const jsonLd = [buildDayEvent(day.data, lang), buildBreadcrumbList(day.data.date, lang)];
---

<BaseLayout
  title={`${day.data.weekday} ${day.data.date}`}
  description={`Programa del ${day.data.date} (${day.data.weekday})${day.data.theme ? ` — ${day.data.theme}` : ''} — Festes de Gata 2026.`}
  lang={lang}
  jsonLd={jsonLd}
>
  <article>
    <p>
      <a href={homeHref}>{labels[lang].back}</a>
    </p>
    <DaySection day={day} lang={lang} headingLevel={1} />
  </article>
</BaseLayout>

<style>
  article > p {
    margin-bottom: var(--spacing-4);
  }
</style>
